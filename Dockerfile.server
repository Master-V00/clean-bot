# ──────────────────────────────────────────────────────────────────────────────
# PanelCleaner Server – multi-stage Docker image
# ──────────────────────────────────────────────────────────────────────────────
FROM python:3.12-slim as base

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY pyproject.toml setup.py ./
COPY pcleaner/ pcleaner/
COPY server/ server/
COPY main.py ./
COPY launch.py ./

# Install CPU-optimised server build
RUN pip install --no-cache-dir -e ".[server,ocr,inpaint]"

# Create required directories
RUN mkdir -p pcleaner/profiles temp_chapters credentials logs

# ── GPU image variant (build with --target=gpu) ─────────────────────────────
# docker build --target=gpu -t panelcleaner-server:gpu .
# docker run --gpus all -p 8000:8000 panelcleaner-server:gpu
FROM base as gpu
# Uninstall CPU-only torch deps first, then install CUDA-enabled torch
RUN pip uninstall -y torch torchvision 2>/dev/null || true; \
    pip install --no-cache-dir ".[gpu]" \
    --index-url https://download.pytorch.org/whl/cu128
# ────────────────────────────────────────────────────────────────────────────

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD python -c "import requests; requests.get('http://localhost:8000/health')"

CMD ["uvicorn", "server.api:app", "--host", "0.0.0.0", "--port", "8000"]
